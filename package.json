{
  "name": "flowdoc",
  "version": "1.0.0",
  "description": "Capture browser workflows and generate Markdown documentation with screenshots",
  "main": "electron/main.js",
  "bin": {
    "flowdoc": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postinstall": "npx playwright install chromium",
    "app": "npm run build && electron .",
    "pw:bundle": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/pw-browsers\" npx playwright install chromium",
    "dist": "npm run build && npm run pw:bundle && electron-builder"
  },
  "keywords": ["documentation", "browser", "workflow", "playwright", "screenshots"],
  "author": "Jörgen Selander <jorgen.selander@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "com.flowdoc.desktop",
    "productName": "FlowDoc",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "pw-browsers",
        "to": "pw-browsers"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FlowDoc records your microphone so it can narrate the workflow you capture."
      }
    },
    "publish": {
      "provider": "github"
    }
  }
}
